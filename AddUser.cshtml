@model MsmePortal.Models.UserViewModel
@{
    ViewData["Title"] = "Add User (अधिकारी / स्टाफ खाता सहेजें)";
    var userList = ViewBag.UserList as List<MsmePortal.Models.UserViewModel> ?? new List<MsmePortal.Models.UserViewModel>();
    var officeLocations = ViewBag.OfficeLocations as List<string> ?? new List<string>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-warning mb-0">
            <i class="bi bi-person-plus-fill me-2"></i> Add User / Staff (अधिकारी व स्टाफ खाता बनाएं)
        </h3>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Standardized Staff Form Card -->
    <div class="card shadow-sm border-0 rounded-3 mb-5">
        <div class="card-header bg-dark text-white fw-bold py-3 d-flex align-items-center justify-content-between">
            <span><i class="bi bi-pencil-square me-2 text-warning"></i> Staff / Officer Location Mapping Form</span>
            <span class="badge bg-warning text-dark">Staff Assignment</span>
        </div>
        <div class="card-body p-4 bg-white">
            <form asp-action="AddUser" method="post" id="userForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Office Location & Role Mapping Container Box -->
                <div class="p-3 mb-4 rounded-3 border border-warning-subtle bg-warning-subtle">
                    <div class="row g-3">
                        <!-- Role Selection Dropdown -->
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label fw-bold">
                                Select Role (भूमिका का चयन करें) <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Role" class="form-select border-warning fw-bold" asp-items="Html.GetEnumSelectList<MsmePortal.Models.UserRole>()">
                            </select>
                            <small class="text-muted">विकल्प: HO_User (बाबू), RO_User (क्षेत्रीय प्रबंधक), DTIC_User (जिला अधिकारी)</small>
                        </div>

                        <!-- Office Location Mapping Dropdown -->
                        <div class="col-md-6">
                            <label asp-for="AssignedOfficeName" class="form-label fw-bold">
                                Office Location Mapping (पदस्थापित कार्यालय का चयन) <span class="text-danger">*</span>
                            </label>
                            <select asp-for="AssignedOfficeName" class="form-select border-warning fw-bold">
                                @foreach (var loc in officeLocations)
                                {
                                    <option value="@loc">@loc</option>
                                }
                            </select>
                            <small class="text-muted">चुनें कि अधिकारी/स्टाफ किस कार्यालय/अनुभाग में तैनात होगा।</small>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <!-- 1. Name -->
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">
                            User / Officer Name (अधिकारी/कर्मचारी का नाम) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="उदा. अनिल शर्मा" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- 2. Address -->
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label fw-semibold">
                            Address (पता) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Address" class="form-control" placeholder="उदा. न्यू मार्केट, भोपाल" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <!-- 3. Contact -->
                    <div class="col-md-6">
                        <label asp-for="Contact" class="form-label fw-semibold">
                            Contact (संपर्क नंबर) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Contact" class="form-control" placeholder="उदा. 9876543210" />
                        <span asp-validation-for="Contact" class="text-danger small"></span>
                    </div>

                    <!-- 4. Email ID -->
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">
                            Email ID (ईमेल/यूज़रनेम) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="anil@mpmsme.gov.in" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- 5. GST No -->
                    <div class="col-md-6">
                        <label asp-for="GstNo" class="form-label fw-semibold">
                            GST No (जीएसटी नंबर) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="GstNo" class="form-control text-uppercase" placeholder="उदा. 23EEEEE0000E1Z9" />
                        <span asp-validation-for="GstNo" class="text-danger small"></span>
                    </div>

                    <!-- 6. Password -->
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold">
                            Password (पासवर्ड) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Form Action Buttons: Save, Clear, Close -->
                <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-success px-4 fw-bold">
                        <i class="bi bi-check-circle-fill me-1"></i> Save (सहेजें)
                    </button>
                    <button type="button" class="btn btn-warning text-dark px-4 fw-bold" onclick="document.getElementById('userForm').reset();">
                        <i class="bi bi-eraser-fill me-1"></i> Clear (साफ़ करें)
                    </button>
                    <a asp-action="Index" class="btn btn-danger px-4 fw-bold ms-auto">
                        <i class="bi bi-x-circle-fill me-1"></i> Close (बंद करें)
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Listing Registered Users & Office Location Assignments -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-secondary text-white fw-bold py-3">
            <i class="bi bi-table me-2"></i> पंजीकृत अधिकारी एवं कार्यालय मैपिंग (Staff & Location Mapping List)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Code</th>
                            <th>Staff Name</th>
                            <th>Role</th>
                            <th>Assigned Office Location</th>
                            <th>Contact</th>
                            <th>Email</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in userList)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td><span class="badge bg-warning text-dark">@user.Code</span></td>
                                <td class="fw-bold">@user.Name</td>
                                <td><span class="badge bg-primary">@user.Role</span></td>
                                <td><span class="badge bg-light text-dark border"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@user.AssignedOfficeName</span></td>
                                <td>@user.Contact</td>
                                <td>@user.Email</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
