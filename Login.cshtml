@model MsmePortal.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "लॉगिन | MSME मध्यप्रदेश";
}

<!DOCTYPE html>
<html lang="hi" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- FOUC Prevention Script -->
    <script>
        (function() {
            const savedTheme = localStorage.getItem('msme-theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>

    <!-- Custom MSME Login Styling -->
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" />
    <style>
        .theme-top-bar {
            position: absolute;
            top: 20px;
            right: 24px;
            z-index: 100;
        }
        .theme-btn-login {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(229, 171, 37, 0.5);
            color: #e5ab25;
            padding: 6px 16px;
            border-radius: 20px;
            font-weight: 600;
            cursor: pointer;
            backdrop-filter: blur(8px);
            transition: all 0.2s;
            font-size: 0.85rem;
        }
        .theme-btn-login:hover {
            background: #e5ab25;
            color: #091733;
        }
        .demo-roles {
            margin-top: 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px dashed rgba(229, 171, 37, 0.4);
            border-radius: 12px;
            padding: 12px 16px;
            color: #d1d5db;
            font-size: 0.82rem;
        }
        .demo-badge {
            cursor: pointer;
            background: rgba(229, 171, 37, 0.15);
            border: 1px solid #e5ab25;
            color: #e5ab25;
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: 600;
            display: inline-block;
            margin: 2px;
            transition: all 0.2s;
        }
        .demo-badge:hover {
            background: #e5ab25;
            color: #091733;
        }
    </style>
</head>
<body class="login-body">

    <!-- Top Theme Toggle Bar -->
    <div class="theme-top-bar">
        <button type="button" class="theme-btn-login" id="loginThemeBtn">
            <i class="bi bi-moon-stars-fill me-1" id="loginThemeIcon"></i>
            <span id="loginThemeText">डार्क मोड</span>
        </button>
    </div>

    <!-- Top Header -->
    <header class="login-header">
        <div class="logo-badge">
            <img src="~/images/msme_logo.jpg" alt="MSME Emblem" />
        </div>
        <h1 class="govt-title">मध्यप्रदेश सरकार</h1>
        <p class="govt-subtitle">सूक्ष्म, लघु और मध्यम उद्यम विभाग (उद्योग संचालनालय, मध्यप्रदेश)</p>
    </header>

    <!-- Main Central Card -->
    <main class="login-card">
        <h2 class="card-title">MSME</h2>

        <form asp-action="Login" asp-controller="Account" method="post" id="loginForm">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary-errors">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <!-- Login ID Field -->
            <div class="form-group">
                <label asp-for="LoginId" class="form-label">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                    लॉगिन आईडी (Login ID)
                </label>
                <div class="input-container">
                    <input asp-for="LoginId" id="loginInput" class="input-field input-light" placeholder="admin" value="admin" autocomplete="username" />
                </div>
            </div>

            <!-- Password Field -->
            <div class="form-group">
                <label asp-for="Password" class="form-label">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v2h2v-2h2v-2h-8.35zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
                    </svg>
                    पासवर्ड (Password)
                </label>
                <div class="input-container">
                    <input asp-for="Password" type="password" id="passwordInput" class="input-field input-dark" placeholder="••••••••••" value="admin123" autocomplete="current-password" />
                    <button type="button" class="eye-toggle-btn" id="togglePasswordBtn" title="पासवर्ड देखें / छिपाएं">
                        <span id="eyeIcon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </button>
                </div>
            </div>

            <!-- Options Row: Remember Me & Forgot Password -->
            <div class="options-row">
                <label class="remember-me">
                    <input asp-for="RememberMe" type="checkbox" checked />
                    <span>मुझे याद रखें</span>
                </label>
                <a href="#" class="forgot-password">पासवर्ड भूल गए?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-submit">
                <span>लॉगिन करें</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </button>
        </form>

        <!-- Quick Demo Login Helper -->
        <div class="demo-roles text-center">
            <div class="fw-bold mb-1 text-warning">🔑 टेस्ट लॉगिन क्रिडेंशियल (Click to Fill):</div>
            <div>
                <span class="demo-badge" onclick="fillCreds('admin', 'admin123')">HO Admin</span>
                <span class="demo-badge" onclick="fillCreds('ro', 'ro123')">RO Login</span>
                <span class="demo-badge" onclick="fillCreds('dtic', 'dtic123')">DTIC Login</span>
                <span class="demo-badge" onclick="fillCreds('user', 'user123')">User Login</span>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="login-footer">
        © 2026 सर्वाधिकार सुरक्षित
    </footer>

    <!-- Interactive JS -->
    <script src="~/js/login.js" asp-append-version="true"></script>
    <script>
        function fillCreds(user, pwd) {
            document.getElementById('loginInput').value = user;
            document.getElementById('passwordInput').value = pwd;
        }

        // Theme Toggle on Login Page
        document.addEventListener('DOMContentLoaded', function () {
            const btn = document.getElementById('loginThemeBtn');
            const icon = document.getElementById('loginThemeIcon');
            const text = document.getElementById('loginThemeText');

            function updateLoginUI(theme) {
                if (theme === 'light') {
                    icon.className = 'bi bi-moon-stars-fill me-1';
                    text.textContent = 'डार्क मोड';
                } else {
                    icon.className = 'bi bi-sun-fill me-1 text-warning';
                    text.textContent = 'लाइट मोड';
                }
            }

            const activeTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            updateLoginUI(activeTheme);

            if (btn) {
                btn.addEventListener('click', function () {
                    const current = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
                    document.documentElement.setAttribute('data-theme', current);
                    localStorage.setItem('msme-theme', current);
                    updateLoginUI(current);
                });
            }
        });
    </script>
</body>
</html>
