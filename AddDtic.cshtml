@model MsmePortal.Models.DticViewModel
@{
    ViewData["Title"] = "Add DTIC (District Trade & Industry Centre)";
    var dticList = ViewBag.DticList as List<MsmePortal.Models.DticViewModel> ?? new List<MsmePortal.Models.DticViewModel>();
    var parentRos = ViewBag.ParentRos as List<string> ?? new List<string>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-info mb-0">
            <i class="bi bi-bank me-2"></i> Add DTIC (जिला व्यापार एवं उद्योग केंद्र जोड़ें)
        </h3>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Standardized Form Card -->
    <div class="card shadow-sm border-0 rounded-3 mb-5">
        <div class="card-header bg-dark text-white fw-bold py-3 d-flex align-items-center justify-content-between">
            <span><i class="bi bi-pencil-square me-2 text-info"></i> DTIC (जिला कार्यालय) फ़ॉर्म</span>
            <span class="badge bg-info text-dark">Level: DTIC</span>
        </div>
        <div class="card-body p-4 bg-white">
            <form asp-action="AddDtic" method="post" id="dticForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <!-- Parent RO Dropdown (DTIC parent = Regional Office) -->
                    <div class="col-md-12">
                        <label asp-for="ParentOfficeName" class="form-label fw-bold text-info">
                            <i class="bi bi-diagram-3-fill me-1"></i> Parent Regional Office (पैरेंट क्षेत्रीय कार्यालय RO) <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ParentOfficeName" class="form-select border-info bg-light fw-bold">
                            @foreach (var ro in parentRos)
                            {
                                <option value="@ro">@ro (Regional Office)</option>
                            }
                        </select>
                        <small class="text-muted d-block mt-1">नोट: हर जिला कार्यालय (DTIC) अपने क्षेत्रीय कार्यालय (RO) के नीचे कार्य करता है।</small>
                    </div>

                    <!-- 1. Name -->
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">
                            DTIC Name (जिला केंद्र का नाम) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="उदा. भोपाल DTIC कार्यालय" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- 2. Address -->
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label fw-semibold">
                            Address (पता) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Address" class="form-control" placeholder="उदा. गोविंदपुरा इंडस्ट्रियल एरिया, भोपाल" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <!-- 3. Contact -->
                    <div class="col-md-6">
                        <label asp-for="Contact" class="form-label fw-semibold">
                            Contact (संपर्क नंबर) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Contact" class="form-control" placeholder="उदा. 0755-2667890" />
                        <span asp-validation-for="Contact" class="text-danger small"></span>
                    </div>

                    <!-- 4. Email ID -->
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">
                            Email ID (ईमेल आईडी) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="dtic.bhopal@mpmsme.gov.in" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- 5. GST No -->
                    <div class="col-md-6">
                        <label asp-for="GstNo" class="form-label fw-semibold">
                            GST No (जीएसटी नंबर) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="GstNo" class="form-control text-uppercase" placeholder="उदा. 23CCCCC0000C1Z7" />
                        <span asp-validation-for="GstNo" class="text-danger small"></span>
                    </div>

                    <!-- 6. Password -->
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold">
                            Password (पासवर्ड) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Action Buttons: Save, Clear, Close -->
                <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top">
                    <button type="submit" class="btn btn-success px-4 fw-bold">
                        <i class="bi bi-check-circle-fill me-1"></i> Save (सहेजें)
                    </button>
                    <button type="button" class="btn btn-warning text-dark px-4 fw-bold" onclick="document.getElementById('dticForm').reset();">
                        <i class="bi bi-eraser-fill me-1"></i> Clear (साफ़ करें)
                    </button>
                    <a asp-action="Index" class="btn btn-danger px-4 fw-bold ms-auto">
                        <i class="bi bi-x-circle-fill me-1"></i> Close (बंद करें)
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table Listing Registered DTICs -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-secondary text-white fw-bold py-3">
            <i class="bi bi-table me-2"></i> पंजीकृत जिला केंद्र सूची (Registered DTIC List)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>DTIC Code</th>
                            <th>DTIC Name</th>
                            <th>Parent RO Office</th>
                            <th>Contact</th>
                            <th>Email</th>
                            <th>GST No</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dtic in dticList)
                        {
                            <tr>
                                <td>@dtic.Id</td>
                                <td><span class="badge bg-info text-dark">@dtic.Code</span></td>
                                <td class="fw-bold">@dtic.Name</td>
                                <td><span class="badge bg-light text-info border">@dtic.ParentOfficeName</span></td>
                                <td>@dtic.Contact</td>
                                <td>@dtic.Email</td>
                                <td><code>@dtic.GstNo</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
